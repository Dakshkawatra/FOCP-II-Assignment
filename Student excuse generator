#include <bits/stdc++.h>
using namespace std;

class StudentExcuseGenerator {

private:

    vector<string> excuseTemplates;

public:

    StudentExcuseGenerator() {

        excuseTemplates = {

            "{name} couldn't complete the assignment because the laptop decided to update for five straight hours.",

            "{name} was ready to submit the homework when the Wi-Fi suddenly disappeared.",

            "{name} tried finishing the assignment, but the keyboard stopped responding during the final save.",

            "{name}'s system crashed exactly two minutes before submission.",

            "{name} accidentally deleted the assignment while cleaning desktop files.",

            "{name} was completing the homework when the power outage ruined everything.",

            "{name} spent hours debugging only to realize the wrong file was being edited.",

            "{name}'s browser closed unexpectedly along with all assignment tabs.",

            "{name} completed the assignment, but the file mysteriously became corrupted.",

            "{name} could not finish the work because the internet speed was slower than human evolution.",

            "{name} was about to upload the assignment when the college portal stopped working.",

            "{name}'s laptop fan started sounding like a helicopter and shut down automatically.",

            "{name} tried completing the homework, but too many Chrome tabs defeated the RAM.",

            "{name} forgot to charge the laptop and discovered it at the worst possible moment.",

            "{name} was writing the final answer when the software froze permanently."
        };
    }

    string replacePlaceholder(string excuse, const string& studentName) {

        string placeholder = "{name}";

        size_t position = excuse.find(placeholder);

        while (position != string::npos) {

            excuse.replace(position, placeholder.length(), studentName);

            position = excuse.find(placeholder);
        }

        return excuse;
    }

    string generateExcuse(const string& studentName) {

        int randomIndex = rand() % excuseTemplates.size();

        return replacePlaceholder(excuseTemplates[randomIndex], studentName);
    }
};

int main() {

    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    srand(time(0));

    StudentExcuseGenerator generator;

    string studentName;

    cout << "=========================================\n";
    cout << "      STUDENT EXCUSE GENERATOR\n";
    cout << "=========================================\n\n";

    cout << "Enter Student Name: ";
    getline(cin, studentName);

    if (studentName.empty()) {

        cout << "\nError: Student name cannot be empty.\n";
        return 0;
    }

    char choice;

    do {

        cout << "\n-----------------------------------------\n";
        cout << "Generated Excuse:\n\n";

        cout << generator.generateExcuse(studentName) << "\n";

        cout << "\n-----------------------------------------\n";

        cout << "\nGenerate another excuse? (Y/N): ";
        cin >> choice;

        cin.ignore(numeric_limits<streamsize>::max(), '\n');

    } while (choice == 'Y' || choice == 'y');

    cout << "\nThank you for using Student Excuse Generator.\n";

    return 0;
}
