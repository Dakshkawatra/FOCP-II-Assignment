#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int T;
    cin >> T;

    while (T--) {
        long long n;
        cin >> n;

        long long ans = 1;

        for (long long i = 2; i * i <= n; i++) {
            int cnt = 0;

            while (n % i == 0) {
                cnt++;
                n /= i;
            }

            if (cnt > 0) {
                ans *= 2;
            }
        }

        if (n > 1) {
            ans *= 2;
        }

        cout << ans << '\n';
    }

    return 0;
}
